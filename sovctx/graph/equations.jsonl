{"id": "EQ:PONTRYAGIN_1960_STATE", "type": "EQUATION", "namespace": "SOV", "label": "Pontryagin controlled state system (1)", "latex": "\\frac{dx^i}{dt}=f^i(x,u),\\quad i=1,\\ldots,n", "original_notation": "dx^i/dt = f^i(x,u), i=1,2,...,n", "normalized_notation": "\\dot x=f(x,u)", "equation_kind": "controlled_state_dynamics", "source_ids": ["PUB:PONTRYAGIN_1960_MAXIMUM"], "source_fragment_ids": ["FRAG:PONTRYAGIN_1960_STATE_EQ1"], "transcription_status": "verified_primary_text", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:PON_X", "SYMBOL:PON_U", "SYMBOL:PON_F", "SYMBOL:PON_CONTROL_SET"], "input_symbol_ids": ["SYMBOL:PON_X", "SYMBOL:PON_U"], "output_symbol_ids": ["SYMBOL:PON_X"], "assumption_ids": ["ASSUMPTION:PON_ADMISSIBLE_CONTROL"], "invariant_ids": [], "operator_ids": ["OP:STATE", "OP:CONTROL"], "behavioral_test_ids": ["TEST:PON_STATE_ZERO_FIELD"], "native_context": "Controlled phase-space dynamics for the object."}
{"id": "EQ:PONTRYAGIN_1960_COST", "type": "EQUATION", "namespace": "SOV", "label": "Pontryagin objective functional (4)", "latex": "J=\\int_{t_0}^{t_1}f^0(x(t),u(t))\\,dt", "original_notation": "J = ∫_{t0}^{t1} f^0(x(t),u(t)) dt", "normalized_notation": "J[u]=\\int f^0(x(t),u(t))dt", "equation_kind": "integral_objective_functional", "source_ids": ["PUB:PONTRYAGIN_1960_MAXIMUM"], "source_fragment_ids": ["FRAG:PONTRYAGIN_1960_COST_EQ4"], "transcription_status": "verified_primary_text", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:PON_J", "SYMBOL:PON_F0", "SYMBOL:PON_X", "SYMBOL:PON_U"], "input_symbol_ids": ["SYMBOL:PON_X", "SYMBOL:PON_U", "SYMBOL:PON_F0"], "output_symbol_ids": ["SYMBOL:PON_J"], "assumption_ids": ["ASSUMPTION:PON_ADMISSIBLE_CONTROL"], "invariant_ids": [], "operator_ids": ["OP:OPTIMIZE", "OP:CONTROL"], "behavioral_test_ids": ["TEST:PON_COST_ZERO", "TEST:PON_COST_CONCATENATE"], "native_context": "Objective minimized among admissible controls transferring the initial state to the target state."}
{"id": "EQ:PONTRYAGIN_1960_HAMILTONIAN", "type": "EQUATION", "namespace": "SOV", "label": "Pontryagin Hamiltonian for time-optimal specialization", "latex": "H(\\psi,x,u)=\\sum_{i=1}^{n}\\psi_i f^i(x,u)", "original_notation": "H(ψ,x,u)=ψ_ν f^ν(x,u) (summation ν=1,...,n)", "normalized_notation": "H=\\psi\\cdot f(x,u)", "equation_kind": "control_hamiltonian", "source_ids": ["PUB:PONTRYAGIN_1960_MAXIMUM"], "source_fragment_ids": ["FRAG:PONTRYAGIN_1960_HAMILTONIAN"], "transcription_status": "verified_primary_text_crosschecked", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:PON_PSI", "SYMBOL:PON_X", "SYMBOL:PON_U", "SYMBOL:PON_F", "SYMBOL:PON_H"], "input_symbol_ids": ["SYMBOL:PON_PSI", "SYMBOL:PON_X", "SYMBOL:PON_U"], "output_symbol_ids": ["SYMBOL:PON_H"], "assumption_ids": ["ASSUMPTION:PON_FIXED_CONTROL_SET"], "invariant_ids": ["INVARIANT:PON_H_LINEAR_PSI"], "operator_ids": ["OP:CONTROL", "OP:OPTIMIZE"], "behavioral_test_ids": ["TEST:PON_H_PSI_ADD", "TEST:PON_H_PSI_SCALE"], "native_context": "Hamiltonian used in the time-optimal maximum-principle formulation.", "notes": "Represents the Mayer-form / time-optimal dynamical Hamiltonian H(ψ, x, u) = \\sum_{i=1}^n ψ_i f^i(x, u), where the running cost multiplier ψ_0 f^0 is normalized (ψ_0 = 0 or absorbed into terminal-time conditions), distinct from the full Bolza/Lagrange form H = ψ_0 f^0 + \\sum ψ_i f^i with ψ_0 <= 0."}
{"id": "EQ:PONTRYAGIN_1960_CANONICAL", "type": "EQUATION", "namespace": "SOV", "label": "Pontryagin Hamiltonian state-adjoint system (18),(19)", "latex": "\\dot x^i=\\frac{\\partial H}{\\partial\\psi_i},\\qquad \\dot\\psi_i=-\\frac{\\partial H}{\\partial x^i}", "original_notation": "dx^i/dt=∂H/∂ψ_i; dψ_i/dt=-∂H/∂x^i", "normalized_notation": "\\dot x=H_\\psi,\\quad \\dot\\psi=-H_x", "equation_kind": "hamiltonian_state_adjoint_system", "source_ids": ["PUB:PONTRYAGIN_1960_MAXIMUM"], "source_fragment_ids": ["FRAG:PONTRYAGIN_1960_HAMILTONIAN"], "transcription_status": "verified_primary_text_crosschecked", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:PON_X", "SYMBOL:PON_PSI", "SYMBOL:PON_H"], "input_symbol_ids": ["SYMBOL:PON_X", "SYMBOL:PON_PSI", "SYMBOL:PON_H"], "output_symbol_ids": ["SYMBOL:PON_X", "SYMBOL:PON_PSI"], "assumption_ids": ["ASSUMPTION:PON_ADMISSIBLE_CONTROL"], "invariant_ids": [], "operator_ids": ["OP:CONTROL", "OP:STATE"], "behavioral_test_ids": ["TEST:PON_CANONICAL_STATE_RECOVERY"], "native_context": "Hamiltonian form of the controlled state equation and adjoint dynamics."}
{"id": "EQ:PONTRYAGIN_1960_MAXIMUM_CONDITION", "type": "EQUATION", "namespace": "SOV", "label": "Pontryagin maximum condition (20)", "latex": "H(\\psi(t),x(t),u(t))=M(\\psi(t),x(t)),\\qquad M(\\psi,x)=\\sup_{u\\in U}H(\\psi,x,u)", "original_notation": "H(ψ(t),x(t),u(t)) (=) M(ψ(t),x(t)); M(ψ,x)=sup_{u∈U}H(ψ,x,u)", "normalized_notation": "u(t)\\in\\arg\\max_{u\\in U}H(\\psi(t),x(t),u)", "equation_kind": "maximum_condition", "source_ids": ["PUB:PONTRYAGIN_1960_MAXIMUM"], "source_fragment_ids": ["FRAG:PONTRYAGIN_1960_MAXIMUM_EQ20"], "transcription_status": "verified_primary_text_crosschecked", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:PON_H", "SYMBOL:PON_M", "SYMBOL:PON_PSI", "SYMBOL:PON_X", "SYMBOL:PON_U", "SYMBOL:PON_CONTROL_SET"], "input_symbol_ids": ["SYMBOL:PON_PSI", "SYMBOL:PON_X", "SYMBOL:PON_CONTROL_SET"], "output_symbol_ids": ["SYMBOL:PON_U", "SYMBOL:PON_M"], "assumption_ids": ["ASSUMPTION:PON_FIXED_CONTROL_SET", "ASSUMPTION:PON_ADMISSIBLE_CONTROL"], "invariant_ids": ["INVARIANT:PON_MAX_DOMINANCE"], "operator_ids": ["OP:CONTROL", "OP:OPTIMIZE"], "behavioral_test_ids": ["TEST:PON_MAX_FINITE_SET"], "native_context": "Necessary maximum condition for the time-optimal problem."}
{"id": "EQ:GELFAND_LEVITAN_1991_SPECTRAL_KERNEL", "type": "EQUATION", "namespace": "RUS", "label": "Gelfand-Levitan spectral-data kernel in later Russian transcription", "latex": "f(x,y)=\\int \\varphi_0(x,t)\\varphi_0(y,t)\\,d\\tau(t)", "original_notation": "f(x,y)=∫ φ0(x,t)φ0(y,t)dτ(t)", "normalized_notation": "f=\\mathcal S[d\\tau]", "equation_kind": "spectral_data_to_kernel_transform", "historical_publication_year": 1951, "transcription_edition_year": 1991, "source_ids": ["PUB:GONCHAR_NOVIKOVA_HENKIN_1991", "PUB:GELFAND_LEVITAN_1951"], "source_fragment_ids": ["FRAG:GL_1991_STANDARD_F"], "transcription_status": "verified_later_russian_transcription", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:GL_F", "SYMBOL:GL_PHI0", "SYMBOL:GL_TAU"], "input_symbol_ids": ["SYMBOL:GL_TAU", "SYMBOL:GL_PHI0"], "output_symbol_ids": ["SYMBOL:GL_F"], "assumption_ids": ["ASSUMPTION:GL_LATER_STANDARD_TRANSCRIPTION"], "invariant_ids": [], "operator_ids": ["OP:SPECTRAL_INVERSE", "OP:INVERSE"], "behavioral_test_ids": ["TEST:GL_F_ZERO_MEASURE"], "native_context": "Standard Gelfand-Levitan reconstruction step printed in a 1991 Russian MathNet source citing the 1951 method.", "notes": "Historical origin is Gelfand-Levitan 1951; exact explicit transcription and notation are bound to the 1991 Russian survey (Gonchar, Novikova, Henkin)."}
{"id": "EQ:GELFAND_LEVITAN_1991_KERNEL_EQ", "type": "EQUATION", "namespace": "RUS", "label": "Gelfand-Levitan linear kernel equation in later Russian transcription", "latex": "f(x,y)+\\int_0^x f(y,t)K(x,t)\\,dt+K(x,y)=0", "original_notation": "f(x,y)+∫_0^x f(y,t)K(x,t)dt+K(x,y)=0", "normalized_notation": "(I+T_f)K=-f", "equation_kind": "linear_inverse_kernel_equation", "historical_publication_year": 1951, "transcription_edition_year": 1991, "source_ids": ["PUB:GONCHAR_NOVIKOVA_HENKIN_1991", "PUB:GELFAND_LEVITAN_1951"], "source_fragment_ids": ["FRAG:GL_1991_KERNEL_EQ"], "transcription_status": "verified_later_russian_transcription", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:GL_F", "SYMBOL:GL_K"], "input_symbol_ids": ["SYMBOL:GL_F"], "output_symbol_ids": ["SYMBOL:GL_K"], "assumption_ids": ["ASSUMPTION:GL_FIXED_F", "ASSUMPTION:GL_LATER_STANDARD_TRANSCRIPTION"], "invariant_ids": ["INVARIANT:GL_LINEAR_IN_K", "INVARIANT:GL_ZERO_F_ZERO_K"], "operator_ids": ["OP:SPECTRAL_INVERSE", "OP:INVERSE"], "behavioral_test_ids": ["TEST:GL_LINEAR_K_ADD", "TEST:GL_LINEAR_K_SCALE", "TEST:GL_ZERO_F"], "native_context": "Later Russian standard form of the Gelfand-Levitan linear integral equation.", "notes": "Historical origin is Gelfand-Levitan 1951; explicit formula here is source-bound to the 1991 Russian transcription."}
{"id": "EQ:GELFAND_LEVITAN_1991_POTENTIAL_RECOVERY", "type": "EQUATION", "namespace": "RUS", "label": "Gelfand-Levitan potential recovery in later Russian transcription", "latex": "q(x)=2\\frac{d}{dx}K(x,x)", "original_notation": "q(x)=2D(K(x,x)), D=d/dx", "normalized_notation": "q=2\\,\\partial_x K(x,x)", "equation_kind": "diagonal_kernel_to_potential", "historical_publication_year": 1951, "transcription_edition_year": 1991, "source_ids": ["PUB:GONCHAR_NOVIKOVA_HENKIN_1991", "PUB:GELFAND_LEVITAN_1951"], "source_fragment_ids": ["FRAG:GL_1991_POTENTIAL_RECOVERY"], "transcription_status": "verified_later_russian_transcription", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:GL_Q", "SYMBOL:GL_K"], "input_symbol_ids": ["SYMBOL:GL_K"], "output_symbol_ids": ["SYMBOL:GL_Q"], "assumption_ids": ["ASSUMPTION:GL_LATER_STANDARD_TRANSCRIPTION"], "invariant_ids": [], "operator_ids": ["OP:SPECTRAL_INVERSE", "OP:INVERSE"], "behavioral_test_ids": ["TEST:GL_CONSTANT_DIAGONAL_ZERO_Q", "TEST:GL_DIAGONAL_SCALE_Q"], "native_context": "Potential recovery from the diagonal derivative of the transformation kernel.", "notes": "Historical origin is Gelfand-Levitan 1951; explicit formula here is source-bound to the 1991 Russian transcription."}
{"id": "EQ:BOCKER_2025_INCREMENT", "type": "EQUATION", "namespace": "MOD", "label": "Leibniz-Bocker infinitesimal motion increment", "latex": "\\phi(t) = x(t+1) - x(t)", "original_notation": "\\phi(t) = x(t+1) - x(t)", "normalized_notation": "\\phi(t) = x(t+1) - x(t)", "equation_kind": "discrete_infinitesimal_motion", "source_ids": ["PUB:BOCKER_2025_LEIBNIZ_FRAMEWORK", "PUB:BOCKER_2025_LEIBNIZ_EXTENDED"], "source_fragment_ids": ["FRAG:BOCKER_2025_INCREMENT_DEFINITION"], "transcription_status": "primary_text_transcription", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:LB_X_T", "SYMBOL:LB_X_T_PLUS_1", "SYMBOL:LB_PHI_T"], "input_symbol_ids": ["SYMBOL:LB_X_T", "SYMBOL:LB_X_T_PLUS_1"], "output_symbol_ids": ["SYMBOL:LB_PHI_T"], "assumption_ids": ["ASSUMPTION:LB_BOUNDED_INCREMENTS"], "invariant_ids": ["INVARIANT:LB_TRANSLATIONAL_DRIFT"], "behavioral_test_ids": ["TEST:LB_STATIC_ZERO_INCREMENT"], "native_context": "The fundamental object of analysis is discrete infinitesimal motion rather than static state.", "notes": "Realizes the Leibnizian thesis: understand the system by how it changes rather than what it is at a moment."}
{"id": "EQ:BOCKER_2025_INCREMENT_COVARIANCE", "type": "EQUATION", "namespace": "MOD", "label": "Leibniz-Bocker local covariance operator of motion", "latex": "C(t) = \\mathbb{E}[\\phi(t)\\phi(t)^\\top]", "original_notation": "C(t) = E[\\phi \\phi^T]", "normalized_notation": "C(t) = \\mathbb{E}[\\phi(t)\\phi(t)^\\top]", "equation_kind": "covariance_operator", "source_ids": ["PUB:BOCKER_2025_LEIBNIZ_FRAMEWORK"], "source_fragment_ids": ["FRAG:BOCKER_2025_COVARIANCE_OPERATOR"], "transcription_status": "primary_text_transcription", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:LB_C_T", "SYMBOL:LB_PHI_T"], "input_symbol_ids": ["SYMBOL:LB_PHI_T"], "output_symbol_ids": ["SYMBOL:LB_C_T"], "assumption_ids": ["ASSUMPTION:LB_LOCAL_STATIONARITY"], "invariant_ids": ["INVARIANT:LB_COVARIANCE_SYMMETRY_PSD"], "behavioral_test_ids": ["TEST:LB_COVARIANCE_PSD"], "native_context": "Local covariance operator of infinitesimal tendencies whose dominant eigenspaces define trajectories on Gr(k, N).", "notes": "Transforms discrete increments into an evolving spectral manifold representation."}
{"id": "EQ:BOCKER_2025_MOTION_DECOMPOSITION", "type": "EQUATION", "namespace": "MOD", "label": "Leibniz-Bocker decomposition of infinitesimal motion", "latex": "\\phi(t) = E_k(t)a(t) + r(t)", "original_notation": "\\phi(t) = E_k(t)a(t) + r(t)", "normalized_notation": "\\phi(t) = E_k(t)a(t) + r(t)", "equation_kind": "spectral_subspace_decomposition", "source_ids": ["PUB:BOCKER_2025_LEIBNIZ_FRAMEWORK"], "source_fragment_ids": ["FRAG:BOCKER_2025_DECOMPOSITION_OF_MOTION"], "transcription_status": "primary_text_transcription", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:LB_PHI_T", "SYMBOL:LB_E_K", "SYMBOL:LB_A_T", "SYMBOL:LB_R_T"], "input_symbol_ids": ["SYMBOL:LB_PHI_T", "SYMBOL:LB_E_K"], "output_symbol_ids": ["SYMBOL:LB_A_T", "SYMBOL:LB_R_T"], "assumption_ids": ["ASSUMPTION:LB_SPECTRAL_GAP"], "invariant_ids": ["INVARIANT:LB_ORTHOGONAL_RESIDUAL"], "behavioral_test_ids": ["TEST:LB_RESIDUAL_ORTHOGONALITY"], "native_context": "Decomposes motion into coordinates along the dominant Grassmannian frame and an orthogonal residual novelty vector.", "notes": "Enforces strict orthogonality E_k^T r = 0."}
{"id": "EQ:BOCKER_2025_COHERENCE", "type": "EQUATION", "namespace": "MOD", "label": "Leibniz-Bocker rank-k spectral coherence", "latex": "\\rho_k(t) = \\frac{\\sum_{i=1}^k \\lambda_i(t)}{\\sum_{i=1}^N \\lambda_i(t)}", "original_notation": "\\rho_k(t) = \\frac{\\lambda_1 + ... + \\lambda_k}{\\sum \\lambda_i}", "normalized_notation": "\\rho_k(t) = \\frac{\\sum_{i=1}^k \\lambda_i(t)}{\\sum_{i=1}^N \\lambda_i(t)}", "equation_kind": "effective_dimensionality_diagnostic", "source_ids": ["PUB:BOCKER_2025_LEIBNIZ_FRAMEWORK", "PUB:BOCKER_2025_LEIBNIZ_EXTENDED"], "source_fragment_ids": ["FRAG:BOCKER_2025_DIAGNOSTIC_TRINITY"], "transcription_status": "primary_text_transcription", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:LB_RHO_K", "SYMBOL:LB_LAMBDA_I"], "input_symbol_ids": ["SYMBOL:LB_LAMBDA_I"], "output_symbol_ids": ["SYMBOL:LB_RHO_K"], "assumption_ids": ["ASSUMPTION:LB_NON_ZERO_VARIANCE"], "invariant_ids": ["INVARIANT:LB_COHERENCE_UNIT_BOUNDS"], "behavioral_test_ids": ["TEST:LB_COHERENCE_BOUNDS"], "native_context": "Fraction of total incremental variance captured by leading k modes on Gr(k, N).", "notes": "Quantifies the effective dimensional confinement of system motion."}
{"id": "EQ:BOCKER_2025_SUBSPACE_CURVATURE", "type": "EQUATION", "namespace": "MOD", "label": "Leibniz-Bocker max-angle Grassmannian displacement speed", "latex": "\\Omega_k(t) = \\frac{1}{\\Delta t} \\max_{1 \\le i \\le k} \\theta_i(t, t+\\Delta t)", "original_notation": "\\Omega_k(t) = \\frac{1}{\\Delta t} \\max_i \\theta_i(t, t+\\Delta t)", "normalized_notation": "\\Omega_k(t) = \\frac{1}{\\Delta t} \\max_{1 \\le i \\le k} \\theta_i(t, t+\\Delta t)", "equation_kind": "grassmannian_displacement_speed", "source_ids": ["PUB:BOCKER_2025_LEIBNIZ_FRAMEWORK", "PUB:BOCKER_2025_LEIBNIZ_EXTENDED"], "source_fragment_ids": ["FRAG:BOCKER_2025_DIAGNOSTIC_TRINITY"], "transcription_status": "primary_text_transcription", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:LB_OMEGA_K", "SYMBOL:LB_THETA_I", "SYMBOL:LB_DELTA_T"], "input_symbol_ids": ["SYMBOL:LB_THETA_I", "SYMBOL:LB_DELTA_T"], "output_symbol_ids": ["SYMBOL:LB_OMEGA_K"], "assumption_ids": ["ASSUMPTION:LB_SPECTRAL_GAP", "ASSUMPTION:LB_HORIZONTAL_FRAME"], "invariant_ids": ["INVARIANT:LB_CURVATURE_NON_NEGATIVE"], "behavioral_test_ids": ["TEST:LB_ZERO_ROTATION_CURVATURE"], "native_context": "First-order Grassmannian displacement speed measuring maximum principal angle rotation rate on Gr(k, N), detecting instantaneous reorientations.", "notes": "Renamed to displacement speed in SOVCTX-G1.1 to distinguish first-order velocity from genuine second-order Riemannian curvature."}
{"id": "EQ:BOCKER_2025_PROJECTOR_CURVATURE", "type": "EQUATION", "namespace": "MOD", "label": "Leibniz-Bocker projector displacement speed", "latex": "\\tilde{\\Omega}_k(t) = \\frac{1}{\\Delta t} \\| P_{t+\\Delta t} - P_t \\|_F", "original_notation": "\\tilde{\\Omega}_k(t) = \\frac{1}{\\Delta t} ||P_{t+\\Delta t} - P_t||_F", "normalized_notation": "\\tilde{\\Omega}_k(t) = \\frac{1}{\\Delta t} \\| P_{t+\\Delta t} - P_t \\|_F", "equation_kind": "projector_displacement_speed", "source_ids": ["PUB:BOCKER_2025_LEIBNIZ_EXTENDED", "PUB:BOCKER_2025_LEIBNIZ_FRAMEWORK"], "source_fragment_ids": ["FRAG:BOCKER_2025_DIAGNOSTIC_TRINITY"], "transcription_status": "primary_text_transcription", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:LB_OMEGA_TILDE_K", "SYMBOL:LB_P_T", "SYMBOL:LB_DELTA_T"], "input_symbol_ids": ["SYMBOL:LB_P_T", "SYMBOL:LB_DELTA_T"], "output_symbol_ids": ["SYMBOL:LB_OMEGA_TILDE_K"], "assumption_ids": ["ASSUMPTION:LB_SMOOTH_COVARIANCE", "ASSUMPTION:LB_HORIZONTAL_FRAME"], "invariant_ids": ["INVARIANT:LB_PROJECTOR_IDEMPOTENCE"], "behavioral_test_ids": ["TEST:LB_PROJECTOR_IDENTITY"], "native_context": "Rotationally invariant Frobenius rate of projector evolution capturing total reorientation speed on Gr(k, N).", "notes": "Forms two-scale displacement speed monitor with Omega_k."}
{"id": "EQ:BOCKER_2025_STREAMING_OJA_UPDATE", "type": "EQUATION", "namespace": "MOD", "label": "Leibniz-Bocker online streaming subspace tracking update", "latex": "W_{t+1}^* = W_t + \\eta_t \\phi(t)\\phi(t)^\\top W_t", "original_notation": "W_{t+1}^* = W_t + \\eta_t \\phi (\\phi^T W_t)", "normalized_notation": "W_{t+1}^* = W_t + \\eta_t \\phi(t)(\\phi(t)^\\top W_t)", "equation_kind": "streaming_subspace_tracker", "source_ids": ["PUB:BOCKER_2025_LEIBNIZ_EXTENDED", "PUB:BOCKER_2025_LEIBNIZ_FRAMEWORK"], "source_fragment_ids": ["FRAG:BOCKER_2025_STREAMING_OJA"], "transcription_status": "primary_text_transcription", "verification_status": "verified_primary", "symbol_ids": ["SYMBOL:LB_W_T", "SYMBOL:LB_PHI_T", "SYMBOL:LB_ETA_T"], "input_symbol_ids": ["SYMBOL:LB_W_T", "SYMBOL:LB_PHI_T", "SYMBOL:LB_ETA_T"], "output_symbol_ids": ["SYMBOL:LB_W_T"], "assumption_ids": ["ASSUMPTION:LB_BOUNDED_INCREMENTS"], "invariant_ids": ["INVARIANT:LB_ORTHONORMAL_FRAME"], "behavioral_test_ids": ["TEST:LB_OJA_STEP_ALIGNMENT"], "native_context": "Oja-style streaming update followed by QR orthonormalization for low-overhead real-time Grassmannian tracking.", "notes": "Associative evaluation W_{t+1}^* = W_t + \\eta_t \\phi (\\phi^\top W_t) with economic QR orthonormalization reduces per-step streaming complexity to O(N k^2) for k << N without forming the N x N outer product."}
