{"id": "EQ:LYAPUNOV_1892_GENERAL_SYSTEM", "type": "EQUATION", "namespace": "ANC", "label": "Lyapunov general stability differential system", "latex": "\\frac{dx_k}{dt}=X_k(t,x_1,\\ldots,x_n),\\quad k=1,\\ldots,n", "original_notation": "dx_k/dt = X_k, (k = 1, 2, ... n)", "normalized_notation": "\\dot x_k=X_k(t,x_1,\\ldots,x_n)", "equation_kind": "state_space_differential_system", "source_ids": ["PUB:LYAPUNOV_1892_GENERAL_STABILITY", "HIST:LYAPUNOV_2007_KRYLOV"], "source_fragment_ids": ["FRAG:LYAPUNOV_2007_GENERAL_SYSTEM"], "transcription_status": "secondary_transcription", "verification_status": "secondary_transcription", "symbol_ids": ["SYMBOL:LYAP_XK", "SYMBOL:LYAP_T", "SYMBOL:LYAP_XFIELD_K"], "input_symbol_ids": ["SYMBOL:LYAP_T", "SYMBOL:LYAP_XK"], "output_symbol_ids": ["SYMBOL:LYAP_XK"], "assumption_ids": ["ASSUMPTION:LYAP_GENERAL_SYSTEM"], "invariant_ids": [], "operator_ids": ["OP:STATE", "OP:STABILITY"], "behavioral_test_ids": ["TEST:LYAP_ZERO_VECTOR_FIELD"], "native_context": "General differential-system form used in later Russian historical transcription of Lyapunov's 1892 stability problem.", "notes": "Equation is catalogued behaviorally as a secondary transcription until the 1892 scan is transcribed directly."}
{"id": "EQ:TIKHONOV_1963_FORWARD_OPERATOR", "type": "EQUATION", "namespace": "SOV", "label": "Tikhonov Fredholm first-kind forward operator", "latex": "A[x,z(s)]=\\int_a^b K(x,s)z(s)\\,ds=u(x),\\quad c\\le x\\le d", "original_notation": "A[x,z(s)] = ∫_a^b K(x,s) z(s) ds = u(x), c≤x≤d", "normalized_notation": "(Az)(x)=\\int_a^b K(x,s)z(s)\\,ds", "equation_kind": "linear_integral_forward_operator", "source_ids": ["PUB:TIKHONOV_1963_ILLPOSED"], "source_fragment_ids": ["FRAG:TIKHONOV_1963_FORWARD_EQ1"], "transcription_status": "verified_scan", "verification_status": "verified_scan", "symbol_ids": ["SYMBOL:TIKH_Z", "SYMBOL:TIKH_U", "SYMBOL:TIKH_KERNEL"], "input_symbol_ids": ["SYMBOL:TIKH_Z", "SYMBOL:TIKH_KERNEL"], "output_symbol_ids": ["SYMBOL:TIKH_U"], "assumption_ids": ["ASSUMPTION:TIKH_FIXED_KERNEL"], "invariant_ids": ["INVARIANT:TIKH_FORWARD_LINEARITY"], "operator_ids": ["OP:INVERSE"], "behavioral_test_ids": ["TEST:TIKH_FORWARD_ADD", "TEST:TIKH_FORWARD_SCALE"], "native_context": "Forward Fredholm equation used by Tikhonov as a typical ill-posed inverse problem.", "notes": "Behavioral tests operate on an exact finite discrete analogue of the integral operator to test linearity."}
{"id": "EQ:TIKHONOV_1963_REGULARIZED_FUNCTIONAL", "type": "EQUATION", "namespace": "SOV", "label": "Tikhonov regularized smoothing functional", "latex": "M^\\alpha[z,\\bar u]=N[z,\\bar u]+\\alpha\\Omega[z]", "original_notation": "M^α[z(s),ū(x)] = N[z(s),ū(x)] + αΩ[z(s)]", "normalized_notation": "M_\\alpha=N+\\alpha\\Omega", "equation_kind": "regularized_objective_functional", "source_ids": ["PUB:TIKHONOV_1963_ILLPOSED"], "source_fragment_ids": ["FRAG:TIKHONOV_1963_FUNCTIONAL_EQ2"], "transcription_status": "verified_scan", "verification_status": "verified_scan", "symbol_ids": ["SYMBOL:TIKH_ALPHA", "SYMBOL:TIKH_N", "SYMBOL:TIKH_OMEGA", "SYMBOL:TIKH_Z", "SYMBOL:TIKH_UBAR"], "input_symbol_ids": ["SYMBOL:TIKH_ALPHA", "SYMBOL:TIKH_N", "SYMBOL:TIKH_OMEGA"], "output_symbol_ids": [], "assumption_ids": ["ASSUMPTION:TIKH_ALPHA_POSITIVE"], "invariant_ids": [], "operator_ids": ["OP:REGULARIZE"], "behavioral_test_ids": ["TEST:TIKH_ALPHA_ZERO", "TEST:TIKH_OMEGA_ZERO", "TEST:TIKH_POSITIVE_PENALTY"], "native_context": "Smoothing functional minimized to construct a regularized approximate solution.", "notes": "Exact source equation (2) from p. 502."}
{"id": "EQ:TIKHONOV_1963_DATA_MISFIT", "type": "EQUATION", "namespace": "SOV", "label": "Tikhonov quadratic data-misfit functional", "latex": "N[z,\\bar u]=\\int_c^d\\left|A[x,z]-\\bar u(x)\\right|^2\\,dx", "original_notation": "N[z(s),ū(x)] = ∫_c^d |A[x,z(s)]-ū(x)|^2 dx", "normalized_notation": "N=\\|Az-\\bar u\\|_2^2", "equation_kind": "quadratic_data_misfit", "source_ids": ["PUB:TIKHONOV_1963_ILLPOSED"], "source_fragment_ids": ["FRAG:TIKHONOV_1963_N_OMEGA"], "transcription_status": "verified_scan", "verification_status": "verified_scan", "symbol_ids": ["SYMBOL:TIKH_N", "SYMBOL:TIKH_Z", "SYMBOL:TIKH_UBAR"], "input_symbol_ids": ["SYMBOL:TIKH_Z", "SYMBOL:TIKH_UBAR"], "output_symbol_ids": ["SYMBOL:TIKH_N"], "assumption_ids": [], "invariant_ids": [], "operator_ids": ["OP:REGULARIZE"], "behavioral_test_ids": ["TEST:TIKH_MISFIT_ZERO_RESIDUAL"], "native_context": "Quadratic mismatch between forward-model output and supplied data."}
{"id": "EQ:TIKHONOV_1963_SMOOTHING_PENALTY", "type": "EQUATION", "namespace": "SOV", "label": "Tikhonov smoothing penalty", "latex": "\\Omega[z]=\\int_a^b\\left(k(s)(z'(s))^2+p(s)z(s)^2\\right)\\,ds,\\quad k(s)>0,\\ p(s)>0", "original_notation": "Ω[z(s)] = ∫_a^b [k(s) z'(s)^2 + p(s) z^2(s)] ds, k(s)>0, p(s)>0", "normalized_notation": "\\Omega=\\int(k z'^2+p z^2)ds", "equation_kind": "smoothing_penalty_functional", "source_ids": ["PUB:TIKHONOV_1963_ILLPOSED"], "source_fragment_ids": ["FRAG:TIKHONOV_1963_N_OMEGA"], "transcription_status": "verified_scan", "verification_status": "verified_scan", "symbol_ids": ["SYMBOL:TIKH_OMEGA", "SYMBOL:TIKH_Z", "SYMBOL:TIKH_KWEIGHT", "SYMBOL:TIKH_PWEIGHT"], "input_symbol_ids": ["SYMBOL:TIKH_Z", "SYMBOL:TIKH_KWEIGHT", "SYMBOL:TIKH_PWEIGHT"], "output_symbol_ids": ["SYMBOL:TIKH_OMEGA"], "assumption_ids": ["ASSUMPTION:TIKH_POSITIVE_WEIGHTS"], "invariant_ids": ["INVARIANT:TIKH_PENALTY_NONNEGATIVE"], "operator_ids": ["OP:REGULARIZE"], "behavioral_test_ids": ["TEST:TIKH_PENALTY_ZERO_FUNCTION", "TEST:TIKH_PENALTY_NONNEGATIVE"], "native_context": "Source-defined regularizing/smoothing functional."}
{"id": "EQ:VLASOV_1938_LINEARIZED_SYSTEM_A", "type": "EQUATION", "namespace": "SOV", "label": "Vlasov linearized continuity-motion-field system (A)", "latex": "\\dot\\rho_1+\\rho_0\\,\\nabla\\!\\cdot\\mathbf u_1=0,\\quad \\rho_0\\dot{\\mathbf u}_1=\\rho_0\\frac{e}{m}\\mathbf E_1,\\quad \\nabla\\!\\cdot\\mathbf E_1=4\\pi\\rho_1\\frac{e}{m}", "original_notation": "System (A) on UFN reproduction p. 445", "normalized_notation": "continuity + force balance + Gauss relation for first-order perturbations", "equation_kind": "linearized_collective_field_system", "source_ids": ["PUB:VLASOV_1967_REPRODUCTION", "PUB:VLASOV_1938_ELECTRON_GAS"], "source_fragment_ids": ["FRAG:VLASOV_1967_SYSTEM_A"], "transcription_status": "verified_scan", "verification_status": "verified_scan", "symbol_ids": ["SYMBOL:VLASOV_RHO1", "SYMBOL:VLASOV_RHO0", "SYMBOL:VLASOV_U1", "SYMBOL:VLASOV_E1", "SYMBOL:VLASOV_ECHARGE", "SYMBOL:VLASOV_M"], "input_symbol_ids": ["SYMBOL:VLASOV_RHO0", "SYMBOL:VLASOV_ECHARGE", "SYMBOL:VLASOV_M"], "output_symbol_ids": ["SYMBOL:VLASOV_RHO1", "SYMBOL:VLASOV_U1", "SYMBOL:VLASOV_E1"], "assumption_ids": ["ASSUMPTION:VLASOV_LINEAR_SMALL_PERTURBATION"], "invariant_ids": [], "operator_ids": ["OP:SELF_CONSISTENT_FIELD"], "behavioral_test_ids": [], "native_context": "First-order plasma perturbation system preceding Vlasov's oscillator reduction."}
{"id": "EQ:VLASOV_1938_PLASMA_OSCILLATOR", "type": "EQUATION", "namespace": "SOV", "label": "Vlasov plasma-density oscillator and frequency", "latex": "\\frac{\\partial^2\\rho_1}{\\partial t^2}+\\omega_0^2\\rho_1=0,\\qquad \\omega_0^2=\\frac{4\\pi N e^2}{m}", "original_notation": "∂²ρ₁/∂t² + ω₀²ρ₁ = 0,  ω₀² = 4πNe²/m", "normalized_notation": "rho1_ddot + omega0^2 rho1 = 0; omega0^2 = 4 pi N e^2/m", "equation_kind": "collective_oscillator_relation", "source_ids": ["PUB:VLASOV_1967_REPRODUCTION", "PUB:VLASOV_1938_ELECTRON_GAS"], "source_fragment_ids": ["FRAG:VLASOV_1967_OSCILLATOR"], "transcription_status": "verified_scan", "verification_status": "verified_scan", "symbol_ids": ["SYMBOL:VLASOV_RHO1", "SYMBOL:VLASOV_OMEGA0", "SYMBOL:VLASOV_N", "SYMBOL:VLASOV_ECHARGE", "SYMBOL:VLASOV_M"], "input_symbol_ids": ["SYMBOL:VLASOV_N", "SYMBOL:VLASOV_ECHARGE", "SYMBOL:VLASOV_M"], "output_symbol_ids": ["SYMBOL:VLASOV_OMEGA0"], "assumption_ids": ["ASSUMPTION:VLASOV_POSITIVE_DENSITY_MASS"], "invariant_ids": ["INVARIANT:VLASOV_FREQUENCY_CHARGE_SIGN"], "operator_ids": ["OP:SELF_OSCILLATE", "OP:SELF_CONSISTENT_FIELD"], "behavioral_test_ids": ["TEST:VLASOV_FREQ_DENSITY_SCALE", "TEST:VLASOV_FREQ_CHARGE_SIGN", "TEST:VLASOV_FREQ_MASS_SCALE"], "native_context": "Oscillator equation obtained in the source by eliminating E1 and u1 from the initial perturbation system."}
{"id": "EQ:VLASOV_1938_KINETIC_FIELD_CORE", "type": "EQUATION", "namespace": "SOV", "label": "Vlasov kinetic-field evolution core from system (I)", "latex": "\\frac{\\partial f_i}{\\partial t}+\\nabla_r\\!\\cdot(\\mathbf v f_i)+\\frac{e_i}{m_i}\\left(\\mathbf E+\\frac{1}{c}\\mathbf v\\times\\mathbf H\\right)\\!\\cdot\\nabla_v f_i=C_i[f]", "original_notation": "Species equations in system (I), UFN reproduction p. 447, with collision terms written as [∂f_i/∂t]^st", "normalized_notation": "transport + Lorentz-field term = collision/source term", "equation_kind": "kinetic_distribution_evolution", "source_ids": ["PUB:VLASOV_1967_REPRODUCTION", "PUB:VLASOV_1938_ELECTRON_GAS"], "source_fragment_ids": ["FRAG:VLASOV_1967_SYSTEM_I"], "transcription_status": "verified_scan_normalized", "verification_status": "verified_scan", "symbol_ids": ["SYMBOL:VLASOV_FI", "SYMBOL:VLASOV_E", "SYMBOL:VLASOV_H"], "input_symbol_ids": ["SYMBOL:VLASOV_E", "SYMBOL:VLASOV_H"], "output_symbol_ids": ["SYMBOL:VLASOV_FI"], "assumption_ids": ["ASSUMPTION:VLASOV_COLLISIONLESS_LIMIT"], "invariant_ids": ["INVARIANT:VLASOV_SELF_CONSISTENT_LOOP"], "operator_ids": ["OP:SELF_CONSISTENT_FIELD"], "behavioral_test_ids": ["TEST:VLASOV_COLLISIONLESS_LIMIT", "TEST:VLASOV_FIELD_FREE_LIMIT"], "native_context": "Normalized species equation extracted from the source's larger system (I); original scan notation retained in fragment provenance.", "notes": "Represents the foundational 1938 kinetic-field evolution equation from System (I) with general collision integral C_i[f] = [∂f_i/∂t]^st. The canonical collisionless Vlasov equation corresponds strictly to the C_i[f] = 0 specialization (formalized under ASSUMPTION:VLASOV_COLLISIONLESS_LIMIT), distinguishing collective self-consistent field dynamics from dissipative Boltzmann/Landau collisions."}
{"id": "EQ:VLASOV_1938_MAXWELL_COUPLING", "type": "EQUATION", "namespace": "SOV", "label": "Vlasov Maxwell coupling and distribution-derived sources", "latex": "\\nabla\\!\\cdot\\mathbf E=4\\pi\\rho,\\quad \\nabla\\!\\times\\mathbf H=\\frac1c\\frac{\\partial\\mathbf E}{\\partial t}+\\frac{4\\pi}{c}\\mathbf j,\\quad \\nabla\\!\\cdot\\mathbf H=0,\\quad \\nabla\\!\\times\\mathbf E=-\\frac1c\\frac{\\partial\\mathbf H}{\\partial t}", "original_notation": "Maxwell block inside system (I), UFN reproduction p. 447; rho and j are given below as velocity integrals of f1 and f2.", "normalized_notation": "Maxwell fields sourced by rho[f] and j[f]", "equation_kind": "self_consistent_field_closure", "source_ids": ["PUB:VLASOV_1967_REPRODUCTION", "PUB:VLASOV_1938_ELECTRON_GAS"], "source_fragment_ids": ["FRAG:VLASOV_1967_SYSTEM_I"], "transcription_status": "verified_scan", "verification_status": "verified_scan", "symbol_ids": ["SYMBOL:VLASOV_E", "SYMBOL:VLASOV_H", "SYMBOL:VLASOV_RHO", "SYMBOL:VLASOV_J", "SYMBOL:VLASOV_FI"], "input_symbol_ids": ["SYMBOL:VLASOV_FI"], "output_symbol_ids": ["SYMBOL:VLASOV_E", "SYMBOL:VLASOV_H"], "assumption_ids": [], "invariant_ids": ["INVARIANT:VLASOV_SELF_CONSISTENT_LOOP"], "operator_ids": ["OP:SELF_CONSISTENT_FIELD"], "behavioral_test_ids": ["TEST:VLASOV_SOURCE_FIELD_LOOP"], "native_context": "Field closure inside source system (I), with charge/current constructed from distribution functions."}
{"id": "EQ:CHEBYSHEV_1853_EXTREMAL_EQ1", "type": "EQUATION", "namespace": "ANC", "label": "Chebyshev minimax extremal equation (1)", "latex": "(f(x)-U(x))^2-L^2=0", "original_notation": "(fx-U)^2-L^2=0", "normalized_notation": "e(x)^2=L^2,\\quad e(x)=f(x)-U(x)", "equation_kind": "minimax_extremal_condition", "source_ids": ["PUB:CHEBYSHEV_1853_PETERSBURG_OFFPRINT"], "source_fragment_ids": ["FRAG:CHEBYSHEV_1853_EQ1"], "transcription_status": "derived_formalization", "verification_status": "derived_formalization", "symbol_ids": ["SYMBOL:CHEB_F", "SYMBOL:CHEB_U", "SYMBOL:CHEB_L", "SYMBOL:CHEB_X"], "input_symbol_ids": ["SYMBOL:CHEB_F", "SYMBOL:CHEB_U", "SYMBOL:CHEB_L", "SYMBOL:CHEB_X"], "output_symbol_ids": [], "assumption_ids": ["ASSUMPTION:CHEB_U_DEGREE_N", "ASSUMPTION:CHEB_INTERVAL"], "invariant_ids": ["INVARIANT:CHEB_ERROR_SIGN"], "operator_ids": ["OP:MINIMAX_APPROXIMATE", "OP:OPTIMIZE"], "behavioral_test_ids": ["TEST:CHEB_EQ1_POS_EXTREME", "TEST:CHEB_EQ1_NEG_EXTREME", "TEST:CHEB_EQ1_SIGN_SWAP"], "native_context": "Condition used to identify the n+2 equal-magnitude extrema of the approximation error.", "notes": "Formalized modern algebraic restatement of Chebyshev's 1853 alternation criterion rather than verbatim orthographic facsimile of the original offprint text."}
{"id": "EQ:CHEBYSHEV_1853_ENDPOINT_EXTREMUM_EQ2", "type": "EQUATION", "namespace": "ANC", "label": "Chebyshev endpoint/interior-extremum equation (2)", "latex": "(x-a+h)(x-a-h)\\frac{d(f(x)-U(x))}{dx}=0", "original_notation": "(x-a+h)(x-a-h) d(fx-U)/dx = 0", "normalized_notation": "((x-a)^2-h^2)e'(x)=0", "equation_kind": "endpoint_stationary_extremum_condition", "source_ids": ["PUB:CHEBYSHEV_1853_PETERSBURG_OFFPRINT"], "source_fragment_ids": ["FRAG:CHEBYSHEV_1853_EQ2"], "transcription_status": "derived_formalization", "verification_status": "derived_formalization", "symbol_ids": ["SYMBOL:CHEB_F", "SYMBOL:CHEB_U", "SYMBOL:CHEB_X", "SYMBOL:CHEB_A", "SYMBOL:CHEB_H"], "input_symbol_ids": ["SYMBOL:CHEB_X", "SYMBOL:CHEB_A", "SYMBOL:CHEB_H"], "output_symbol_ids": [], "assumption_ids": ["ASSUMPTION:CHEB_INTERVAL"], "invariant_ids": [], "operator_ids": ["OP:MINIMAX_APPROXIMATE"], "behavioral_test_ids": ["TEST:CHEB_EQ2_LEFT_ENDPOINT", "TEST:CHEB_EQ2_RIGHT_ENDPOINT", "TEST:CHEB_EQ2_INTERIOR_STATIONARY"], "native_context": "Combines interval endpoints and interior stationary points as candidates for the equal extrema in the minimax construction.", "notes": "Formalized modern algebraic restatement of Chebyshev's 1853 alternation criterion rather than verbatim orthographic facsimile of the original offprint text."}
