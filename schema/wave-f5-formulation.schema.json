{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/NB11B/MAPEOGEO/main/schema/wave-f5-formulation.schema.json",
  "title": "Wave F5 Canonical Formulation Specification",
  "description": "Schema for structured mathematical formulations with typed scopes and source bindings.",
  "type": "object",
  "required": ["schema_version", "formulations"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["0.22"]
    },
    "description": {
      "type": "string"
    },
    "formulations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CanonicalFormulation"
      }
    }
  },
  "definitions": {
    "CanonicalFormulation": {
      "type": "object",
      "required": [
        "canonical_id",
        "family_code",
        "name",
        "kind",
        "scope",
        "hypotheses",
        "conclusion",
        "source_bindings"
      ],
      "properties": {
        "canonical_id": {
          "type": "string",
          "pattern": "^canonical:[a-z0-9_:]+$"
        },
        "family_code": {
          "type": "string",
          "pattern": "^[A-F][0-9]{2}$"
        },
        "name": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["DEFINITION", "THEOREM", "PROPOSITION", "LEMMA", "COROLLARY", "CONSTRUCTION", "COUNTEREXAMPLE"]
        },
        "scope": {
          "$ref": "#/definitions/StructuredScope"
        },
        "hypotheses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conclusion": { "type": "string" },
        "source_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_key", "locator"],
            "properties": {
              "source_key": { "type": "string" },
              "locator": { "type": "string" },
              "statement_sha256": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "StructuredScope": {
      "type": "object",
      "required": [
        "space_type",
        "scalar_field",
        "topology_or_norm",
        "dimension_bound",
        "operator_domain",
        "regularity",
        "quantifier_structure"
      ],
      "properties": {
        "space_type": { "type": "string" },
        "scalar_field": { "type": "string" },
        "topology_or_norm": { "type": "string" },
        "dimension_bound": { "type": "string" },
        "operator_domain": { "type": "string" },
        "regularity": { "type": "string" },
        "quantifier_structure": { "type": "string" },
        "parameter_box": { "type": "string" },
        "exceptions": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
