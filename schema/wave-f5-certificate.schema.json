{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/google/mapeogeo/main/schema/wave-f5-certificate.schema.json",
  "title": "MAPEOGEO Wave F5 Correspondence Certificate Specification",
  "description": "Schema for multi-view correspondence certificates requiring independent witness quorum, typed mathematical scopes, and validated evidence replay in Wave F5 (v0.22).",
  "type": "object",
  "required": ["schema_version", "certificates"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["0.22"]
    },
    "description": {
      "type": "string"
    },
    "certificates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/WaveF5CorrespondenceCertificate"
      }
    }
  },
  "definitions": {
    "WaveF5CorrespondenceCertificate": {
      "type": "object",
      "required": [
        "certificate_id",
        "target_concept",
        "relationship",
        "scope",
        "view_slots",
        "quorum_count",
        "verification_status"
      ],
      "properties": {
        "certificate_id": {
          "type": "string",
          "pattern": "^cert:[a-zA-Z0-9_:-]+$"
        },
        "target_concept": {
          "type": "string"
        },
        "relationship": {
          "type": "string",
          "enum": [
            "SCOPED_OVERLAP",
            "SCOPED_TRANSFER",
            "BOUNDED_INSTANCE",
            "NUMERICAL_EXPERIMENT",
            "DUALITY_BETWEEN",
            "HOMOLOGICAL_DUALITY",
            "COMPLEX_COMMUTATIVITY",
            "SPECTRAL_DECOMPOSITION",
            "SPECTRAL_DECOMPOSITION_OF",
            "MONOTONE_ALONG",
            "CONTRACTION_OF",
            "ACTS_ON",
            "SURGERY_OF",
            "BLOWS_UP_AS",
            "COUPLING_OF",
            "OPERATOR_ACTION",
            "FIXED_POINT_CONSTRUCTION",
            "EVOLUTION_FLOW",
            "LINEARIZATION",
            "CONTINUOUS_DEPENDENCE"
          ]
        },
        "scope": {
          "$ref": "#/definitions/TypedScopeRecord"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "EXACT_RATIONAL",
            "SYMBOLIC_IDENTITY",
            "VALIDATED_ENCLOSURE",
            "FORMAL_GENERAL",
            "COUNTEREXAMPLE",
            "NUMERICAL_EXPERIMENT"
          ]
        },
        "view_slots": {
          "type": "object",
          "required": ["eo", "geo", "pct", "formal"],
          "properties": {
            "eo": { "$ref": "#/definitions/ViewSlot" },
            "geo": { "$ref": "#/definitions/ViewSlot" },
            "pct": { "$ref": "#/definitions/ViewSlot" },
            "formal": { "$ref": "#/definitions/ViewSlot" },
            "enclosure": { "$ref": "#/definitions/ViewSlot" }
          },
          "additionalProperties": false
        },
        "quorum_count": {
          "type": "integer",
          "minimum": 0
        },
        "verification_status": {
          "type": "string",
          "enum": ["CERTIFIED", "PROVISIONAL", "INSUFFICIENT_QUORUM", "REJECTED", "FALSIFIED"]
        },
        "rejection_reason": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "not": {
        "properties": {
          "relationship": {
            "enum": ["SAME_SEMANTICS", "EQUIVALENT_TO", "IDENTICAL_TO"]
          }
        }
      },
      "additionalProperties": false
    },
    "ViewSlot": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ABSENT", "WITNESSED", "REPRESENTED", "VERIFIED", "REFUSED"]
        },
        "view_ref": {
          "type": "string"
        },
        "producer_id": {
          "type": "string"
        },
        "statement_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "witness_payload": {
          "type": "object"
        },
        "formal_receipt": {
          "type": "object",
          "required": ["theorem_name", "module_path", "axiom_audit", "build_hash"],
          "properties": {
            "theorem_name": { "type": "string" },
            "module_path": { "type": "string" },
            "axiom_audit": { "type": "array", "items": { "type": "string" } },
            "build_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "kernel_verified": {
          "type": "boolean"
        },
        "source_file": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TypedScopeRecord": {
      "type": "object",
      "required": [
        "domain",
        "dimension",
        "coefficient_ring",
        "regularity",
        "orientation_convention",
        "boundary_convention",
        "parameter_range",
        "exceptional_cases"
      ],
      "properties": {
        "domain": { "type": "string" },
        "dimension": { "type": "string" },
        "coefficient_ring": { "type": "string" },
        "regularity": { "type": "string" },
        "orientation_convention": { "type": "string" },
        "boundary_convention": { "type": "string" },
        "parameter_range": { "type": "string" },
        "exceptional_cases": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
