{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapeogeo.org/schemas/pdi_v0.schema.json",
  "title": "PDI_v0_Model_Proposal_Grammar",
  "description": "Deterministic JSON output grammar for SmolLM2-135M under Proposal-Disposition Interface v0.1",
  "type": "object",
  "required": ["schema_version", "kind"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Contract schema version (must be 1)"
    },
    "kind": {
      "type": "string",
      "enum": ["OBSERVE", "PROPOSE", "COMPARE", "CLARIFY", "ESCALATE"],
      "description": "Model operation kind"
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": { "const": "PROPOSE" },
        "operator_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33,
          "description": "Authoritative operator ID from pdi_v0_operators.json"
        },
        "object_refs": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "minItems": 0,
          "maxItems": 4,
          "description": "State address (0..255) or graph node references"
        },
        "dest_ref": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Target destination state memory address (0..255)"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["u32", "i32", "fixed_q16_16", "cl20_mv", "addr8"]
              },
              "value": {
                "oneOf": [
                  { "type": "integer" },
                  { "type": "number" },
                  {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 4,
                    "maxItems": 4
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "maxItems": 4
        },
        "goal_ref": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "assumed_state_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Authoritative state version assumed by the model"
        }
      },
      "required": ["operator_id", "object_refs", "assumed_state_version"]
    },
    {
      "properties": {
        "kind": { "const": "OBSERVE" },
        "projection_type": {
          "type": "string",
          "enum": ["STATE", "GRAPH", "EVIDENCE", "TELEMETRY"]
        },
        "target_refs": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "minItems": 1,
          "maxItems": 8
        },
        "radius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": ["projection_type", "target_refs"]
    },
    {
      "properties": {
        "kind": { "const": "COMPARE" },
        "left_ref": { "type": "integer", "minimum": 0, "maximum": 255 },
        "right_ref": { "type": "integer", "minimum": 0, "maximum": 255 },
        "comparator": {
          "type": "string",
          "enum": ["EQ", "APPROX", "NORM"]
        }
      },
      "required": ["left_ref", "right_ref"]
    },
    {
      "properties": {
        "kind": { "const": "CLARIFY" },
        "missing_slots": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "ambiguity_reason": {
          "type": "string"
        },
        "candidate_interpretations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["missing_slots", "ambiguity_reason"]
    },
    {
      "properties": {
        "kind": { "const": "ESCALATE" },
        "requested_capability": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        },
        "target_work_id": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["requested_capability", "reason"]
    }
  ]
}
