  "declarations": [
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.OrderedField",
      "node_id": "src:lebl:sec1_1:ordered_field_structure",
      "reasbook_alignment": "Lebl v6.2 \u00a71.1 <-> v6.3 \u00a71.1 (Identical axioms)",
      "secondary_ref": "Trench \u00a71.1 Definition 1.1.1",
      "section": "\u00a71.1",
      "source_ref": "Definition 1.1.1, 1.1.7, Proposition 1.1.8",
      "statement_sha256": "ec79b427adb42b51691164e745a95badc041d04600d659d413e6be2f86dec19d",
      "statement_text": "An ordered field F is a field with a strict total order < satisfying: (i) x < y implies x + z < y + z; (ii) x > 0 and y > 0 implies xy > 0.",
      "theorem_type": "DEFINITION_AND_PROPOSITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.AbsValTriangleIneq",
      "node_id": "src:lebl:sec1_1:absolute_value_inequalities",
      "reasbook_alignment": "Lebl v6.2 Prop 1.1.13 <-> v6.3 Prop 1.1.13 (Identical)",
      "secondary_ref": "Trench \u00a71.1 Theorem 1.1.3",
      "section": "\u00a71.1",
      "source_ref": "Definition 1.1.12, Proposition 1.1.13 (Triangle Inequality)",
      "statement_sha256": "cb3350f6d85f46b8f907974f59bd362a3a3b68c2fdec523946395b827493623f",
      "statement_text": "For all x, y in R: |x + y| <= |x| + |y| and ||x| - |y|| <= |x - y|.",
      "theorem_type": "PROPOSITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.SupInfDef",
      "node_id": "src:lebl:sec1_2:suprema_and_infima",
      "reasbook_alignment": "Lebl v6.2 Def 1.2.1 <-> v6.3 Def 1.2.1 (Identical)",
      "secondary_ref": "Trench \u00a71.1 Definition 1.1.2",
      "section": "\u00a71.2",
      "source_ref": "Definition 1.2.1, 1.2.2",
      "statement_sha256": "9fbf23cc02b95f1ce2d2506ce4b8bb0196ae5b71098d92fe4034b629b886d28b",
      "statement_text": "Let E subset R. M = sup E if M is an upper bound of E and for every upper bound M', M <= M'. Equivalently, for every eps > 0 there exists x in E with x > M - eps.",
      "theorem_type": "DEFINITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.LeastUpperBoundAxiom",
      "node_id": "src:lebl:sec1_2:least_upper_bound_property",
      "reasbook_alignment": "Lebl v6.2 Axiom 1.2.3 <-> v6.3 Axiom 1.2.3 (Identical)",
      "secondary_ref": "Trench \u00a71.1 Axiom 1.1.1",
      "section": "\u00a71.2",
      "source_ref": "Axiom 1.2.3 (Completeness Property of R)",
      "statement_sha256": "26af3c5d495f9c9c11e02ce6ad568b373bf739c174875f6d1f26512295a7b764",
      "statement_text": "Every nonempty subset E of R that is bounded above has a least upper bound sup E in R.",
      "theorem_type": "AXIOM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.ArchimedeanProperty",
      "node_id": "src:lebl:sec1_2:archimedean_property",
      "reasbook_alignment": "Lebl v6.2 Thm 1.2.5 <-> v6.3 Thm 1.2.5 (Identical)",
      "secondary_ref": "Trench \u00a71.1 Theorem 1.1.4",
      "section": "\u00a71.2",
      "source_ref": "Theorem 1.2.5 (Archimedean Property)",
      "statement_sha256": "3cfa0e8a036ca495b5e321e8bd5115c68b8304737475f8f86900b76fdb1a2bcd",
      "statement_text": "For all x in R, there exists n in N such that n > x. Equivalently, for all eps > 0, there exists n in N such that 1/n < eps.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.DensityOfRationals",
      "node_id": "src:lebl:sec1_2:density_of_rationals",
      "reasbook_alignment": "Lebl v6.2 Thm 1.2.6 <-> v6.3 Thm 1.2.6 (Identical)",
      "secondary_ref": "Trench \u00a71.1 Theorem 1.1.5",
      "section": "\u00a71.2",
      "source_ref": "Theorem 1.2.6 (Density of Q in R)",
      "statement_sha256": "0744ffd007879a0334b7727b0ce662d8cc95a5dc10cb6aa4b7f88a52201bed68",
      "statement_text": "For every x, y in R with x < y, there exists a rational number q in Q such that x < q < y.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.NestedIntervalProperty",
      "node_id": "src:lebl:sec1_5:nested_interval_property",
      "reasbook_alignment": "Lebl v6.2 Thm 1.5.1 <-> v6.3 Thm 1.5.1 (Identical)",
      "secondary_ref": "Trench \u00a71.2 Theorem 1.2.1",
      "section": "\u00a71.5",
      "source_ref": "Theorem 1.5.1 (Cantor's Nested Interval Theorem)",
      "statement_sha256": "760b0f3c454695f71f6753ae4bf7c7ffa5c5fcd1712700f58b787e77e7486689",
      "statement_text": "If I_n = [a_n, b_n] is a sequence of nested closed bounded intervals (I_{n+1} subset I_n), then bigcap_{n=1}^infty I_n is nonempty. If length(I_n) -> 0, the intersection contains exactly one point.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.CauchyCompleteness",
      "node_id": "src:lebl:sec2_2:cauchy_completeness_and_equivalents",
      "reasbook_alignment": "Lebl v6.2 Thm 2.2.12 <-> v6.3 Thm 2.2.12 (Identical)",
      "secondary_ref": "Trench \u00a71.2 Theorem 1.2.2",
      "section": "\u00a72.2",
      "source_ref": "Theorem 2.2.12 (Completeness of R)",
      "statement_sha256": "dd027a110ce4fe60955cd25fb74317f2d4ef6fabf45fd6f30c6b4161f8ddb572",
      "statement_text": "In R, a sequence converges if and only if it is a Cauchy sequence. The least-upper-bound property, nested interval property, and Cauchy completeness are equivalent in Archimedean ordered fields.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.SeqConvergence",
      "node_id": "src:lebl:sec2_1:sequence_convergence",
      "reasbook_alignment": "Lebl v6.2 Def 2.1.1 <-> v6.3 Def 2.1.1 (Identical)",
      "secondary_ref": "Trench \u00a72.1 Definition 2.1.1",
      "section": "\u00a72.1",
      "source_ref": "Definition 2.1.1 (Limit of Sequence)",
      "statement_sha256": "a3ff099ab7727d9351cff7012ba7ebe32e61ba168603f58924578b31fb717872",
      "statement_text": "A sequence (x_n) converges to L in R if for every eps > 0 there exists N in N such that for all n >= N, |x_n - L| < eps.",
      "theorem_type": "DEFINITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.LimitAlgebraAndOrder",
      "node_id": "src:lebl:sec2_1:algebra_and_order_of_limits",
      "reasbook_alignment": "Lebl v6.2 Prop 2.1.17 <-> v6.3 Prop 2.1.17 (Identical)",
      "secondary_ref": "Trench \u00a72.1 Theorem 2.1.4, Theorem 2.1.8",
      "section": "\u00a72.1",
      "source_ref": "Proposition 2.1.10 (Squeeze Lemma), Proposition 2.1.17 (Algebra of Limits)",
      "statement_sha256": "57edd77aceb9a44b021281b36618ac92338627ad0c11b426d29e887bab8cd2c5",
      "statement_text": "If x_n -> L and y_n -> M, then x_n + y_n -> L + M, x_n y_n -> LM, and x_n / y_n -> L / M (if M != 0). If a_n <= b_n <= c_n and a_n -> L, c_n -> L, then b_n -> L.",
      "theorem_type": "PROPOSITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.MonotoneConvergence",
      "node_id": "src:lebl:sec2_1:monotone_convergence",
      "reasbook_alignment": "Lebl v6.2 Thm 2.1.14 <-> v6.3 Thm 2.1.14 (Identical)",
      "secondary_ref": "Trench \u00a72.1 Theorem 2.1.9",
      "section": "\u00a72.1",
      "source_ref": "Theorem 2.1.14 (Monotone Convergence Theorem)",
      "statement_sha256": "87e800f6a736bb115aa56dca8abdb459e9b110fb34a749f0198a85285bda77bb",
      "statement_text": "A monotone sequence of real numbers converges if and only if it is bounded. If (x_n) is monotone increasing and bounded above, then lim x_n = sup {x_n}.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.BolzanoWeierstrass",
      "node_id": "src:lebl:sec2_2:bolzano_weierstrass",
      "reasbook_alignment": "Lebl v6.2 Thm 2.2.5 <-> v6.3 Thm 2.2.5 (Identical)",
      "secondary_ref": "Trench \u00a72.2 Theorem 2.2.3",
      "section": "\u00a72.2",
      "source_ref": "Theorem 2.2.5 (Bolzano\u2013Weierstrass Theorem)",
      "statement_sha256": "e6f4632720fb484f0e0d18cac5badec9c6c0686d50d95880ec279936b5262ef0",
      "statement_text": "Every bounded sequence of real numbers contains a convergent subsequence.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.CauchyCriterion",
      "node_id": "src:lebl:sec2_2:cauchy_criterion",
      "reasbook_alignment": "Lebl v6.2 Thm 2.2.12 <-> v6.3 Thm 2.2.12 (Identical)",
      "secondary_ref": "Trench \u00a72.2 Definition 2.2.4, Theorem 2.2.4",
      "section": "\u00a72.2",
      "source_ref": "Definition 2.2.8, Theorem 2.2.12 (Cauchy Criterion)",
      "statement_sha256": "8a9997d53f2f4be38853a8831a99b288bf095cad30b9300d4cc8f8d40da8257b",
      "statement_text": "A sequence (x_n) in R is Cauchy if for every eps > 0 there exists N in N such that for all n, m >= N, |x_n - x_m| < eps. A sequence in R converges if and only if it is Cauchy.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.InfiniteSeriesDef",
      "node_id": "src:lebl:sec2_5:infinite_series",
      "reasbook_alignment": "Lebl v6.2 Def 2.5.1 <-> v6.3 Def 2.5.1 (Identical)",
      "secondary_ref": "Trench \u00a74.1 Definition 4.1.1",
      "section": "\u00a72.5",
      "source_ref": "Definition 2.5.1 (Convergence of Series)",
      "statement_sha256": "4926a0ad50e1edebf76198b488abed726caf912348d28a9691d6bcb22c3136b1",
      "statement_text": "An infinite series sum_{k=1}^infty a_k converges to S if the sequence of partial sums s_n = sum_{k=1}^n a_k converges to S.",
      "theorem_type": "DEFINITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.SeriesConvergenceTests",
      "node_id": "src:lebl:sec2_5:comparison_ratio_root_tests",
      "reasbook_alignment": "Lebl v6.2 Thm 2.5.9 <-> v6.3 Thm 2.5.9 (Identical)",
      "secondary_ref": "Trench \u00a74.2 Theorem 4.2.1, 4.2.4, 4.2.6",
      "section": "\u00a72.5",
      "source_ref": "Theorem 2.5.9 (Comparison Test), Theorem 2.5.15 (Ratio Test), Theorem 2.5.17 (Root Test)",
      "statement_sha256": "acd66e951124037a930b888a8a9acaec06ba7fc31bc8095a5aacebe9faff907f",
      "statement_text": "If 0 <= a_n <= b_n and sum b_n converges, then sum a_n converges. If limsup |a_{n+1}/a_n| < 1 or limsup |a_n|^{1/n} < 1, then sum a_n converges absolutely.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.AbsVsCondConvergence",
      "node_id": "src:lebl:sec2_5:absolute_vs_conditional_convergence",
      "reasbook_alignment": "Lebl v6.2 Thm 2.5.12 <-> v6.3 Thm 2.5.12 (Identical)",
      "secondary_ref": "Trench \u00a74.3 Theorem 4.3.1, 4.3.3",
      "section": "\u00a72.5",
      "source_ref": "Definition 2.5.11, Theorem 2.5.12, Theorem 2.5.14 (Alternating Series)",
      "statement_sha256": "b88acc529c2b547d5e2fe740b474e280514b6971eafac03b90c3d3a71ce98299",
      "statement_text": "If sum |a_k| converges, then sum a_k converges (absolute convergence implies convergence). A series converging without absolute convergence is conditionally convergent.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.OpenClosedSets",
      "node_id": "src:lebl:sec3_1:open_and_closed_sets",
      "reasbook_alignment": "Lebl v6.2 Def 3.1.6 <-> v6.3 Def 3.1.6 (Identical)",
      "secondary_ref": "Trench \u00a71.3 Definition 1.3.1, 1.3.3",
      "section": "\u00a73.1",
      "source_ref": "Definition 3.1.3 (Open Ball), Definition 3.1.6 (Open and Closed Sets)",
      "statement_sha256": "af1d2751505909b25c286eed634e80f5185b92d0755f0b52db4174257df6b9e6",
      "statement_text": "U subset R is open if for every x in U there exists eps > 0 with (x - eps, x + eps) subset U. E is closed if its complement R \\ E is open.",
      "theorem_type": "DEFINITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.HeineBorel",
      "node_id": "src:lebl:sec3_1:compactness_and_heine_borel",
      "reasbook_alignment": "Lebl v6.2 Thm 3.1.20 <-> v6.3 Thm 3.1.20 (Identical)",
      "secondary_ref": "Trench \u00a71.3 Theorem 1.3.4 (Heine\u2013Borel)",
      "section": "\u00a73.1",
      "source_ref": "Definition 3.1.19 (Open Cover, Compactness), Theorem 3.1.20 (Heine\u2013Borel)",
      "statement_sha256": "0374bc8200889ef841f3f21d645304bd07bf8f2298841a799e3bb8d871e5746c",
      "statement_text": "K subset R is compact if every open cover of K contains a finite subcover. A subset K of R is compact if and only if K is closed and bounded (Heine\u2013Borel).",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.FunctionLimitDef",
      "node_id": "src:lebl:sec3_2:function_limits",
      "reasbook_alignment": "Lebl v6.2 Def 3.2.1 <-> v6.3 Def 3.2.1 (Identical)",
      "secondary_ref": "Trench \u00a72.1 Definition 2.1.2",
      "section": "\u00a73.2",
      "source_ref": "Definition 3.2.1 (Limit of Function)",
      "statement_sha256": "6d324d1bc9c0c34aef5129d355edf218a153dbe1d22408e0353c75c52f5c2f5a",
      "statement_text": "lim_{x -> c} f(x) = L if for every eps > 0 there exists delta > 0 such that for all x in dom(f) with 0 < |x - c| < delta, |f(x) - L| < eps.",
      "theorem_type": "DEFINITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.ContinuityDef",
      "node_id": "src:lebl:sec3_3:continuity",
      "reasbook_alignment": "Lebl v6.2 Def 3.3.1 <-> v6.3 Def 3.3.1 (Identical)",
      "secondary_ref": "Trench \u00a72.2 Definition 2.2.1",
      "section": "\u00a73.3",
      "source_ref": "Definition 3.3.1 (Continuity at a Point)",
      "statement_sha256": "468417c4eba4746eac3d3e9eed3434dbdfeb6f102564e6886f3735c35bcc581f",
      "statement_text": "f: A -> R is continuous at x0 in A if for every eps > 0 there exists delta > 0 such that for all x in A with |x - x0| < delta, |f(x) - f(x0)| < eps.",
      "theorem_type": "DEFINITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.SequentialContinuity",
      "node_id": "src:lebl:sec3_3:sequential_continuity",
      "reasbook_alignment": "Lebl v6.2 Prop 3.3.2 <-> v6.3 Prop 3.3.2 (Identical)",
      "secondary_ref": "Trench \u00a72.2 Theorem 2.2.2",
      "section": "\u00a73.3",
      "source_ref": "Proposition 3.3.2 (Sequential Characterization of Continuity)",
      "statement_sha256": "05ebb82016df2ee6dc3852549c29cd486bb27e07bb354dfe3f4bd23247bbf6ac",
      "statement_text": "f: A -> R is continuous at x0 if and only if for every sequence (x_n) in A converging to x0, f(x_n) converges to f(x0).",
      "theorem_type": "PROPOSITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.IntermediateValueTheorem",
      "node_id": "src:lebl:sec3_3:intermediate_value_theorem",
      "reasbook_alignment": "Lebl v6.2 Thm 3.3.13 <-> v6.3 Thm 3.3.13 (Identical)",
      "secondary_ref": "Trench \u00a72.2 Theorem 2.2.7",
      "section": "\u00a73.3",
      "source_ref": "Theorem 3.3.13 (Intermediate Value Theorem)",
      "statement_sha256": "e7e4ebd3c4c9f6d90c6054fb42e8a67a7daad7f262dbc8653107dc8d6f786704",
      "statement_text": "Let f: [a, b] -> R be continuous. If y is between f(a) and f(b), then there exists c in [a, b] such that f(c) = y.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.ExtremeValueTheorem",
      "node_id": "src:lebl:sec3_3:extreme_value_theorem",
      "reasbook_alignment": "Lebl v6.2 Thm 3.3.10 <-> v6.3 Thm 3.3.10 (Identical)",
      "secondary_ref": "Trench \u00a72.2 Theorem 2.2.6",
      "section": "\u00a73.3",
      "source_ref": "Theorem 3.3.10 (Extreme Value Theorem)",
      "statement_sha256": "0bc7d988e85fc3303721e126f373c9737cb52f9e9057111bd2b81cd617cb99da",
      "statement_text": "If K subset R is compact and f: K -> R is continuous, then f is bounded and achieves its minimum and maximum on K: exists x_min, x_max in K such that f(x_min) <= f(x) <= f(x_max) for all x in K.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.UniformContinuityHeineCantor",
      "node_id": "src:lebl:sec3_4:uniform_continuity_and_heine_cantor",
      "reasbook_alignment": "Lebl v6.2 Thm 3.4.4 <-> v6.3 Thm 3.4.4 (Identical)",
      "secondary_ref": "Trench \u00a72.3 Definition 2.3.1, Theorem 2.3.3",
      "section": "\u00a73.4",
      "source_ref": "Definition 3.4.1 (Uniform Continuity), Theorem 3.4.4 (Heine\u2013Cantor Theorem)",
      "statement_sha256": "b0442ad5b2325a7e3dbb7bd9498f0a1ea591385d9419e8add1264c4b6960f1aa",
      "statement_text": "f: A -> R is uniformly continuous if for every eps > 0 there exists delta > 0 such that for all x, y in A with |x - y| < delta, |f(x) - f(y)| < eps. If K is compact and f: K -> R is continuous, then f is uniformly continuous.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.DerivativeDef",
      "node_id": "src:lebl:sec4_1:derivative",
      "reasbook_alignment": "Lebl v6.2 Def 4.1.1 <-> v6.3 Def 4.1.1 (Identical)",
      "secondary_ref": "Trench \u00a72.3 Definition 2.3.2, Theorem 2.3.1",
      "section": "\u00a74.1",
      "source_ref": "Definition 4.1.1 (Derivative), Proposition 4.1.4 (Differentiable implies Continuous)",
      "statement_sha256": "9733468860a978dd2dcc3f244054485c84c69e14310607cb0e73bfffb5b3ab1a",
      "statement_text": "f: I -> R is differentiable at x0 in I if lim_{x -> x0} (f(x) - f(x0))/(x - x0) exists. If f is differentiable at x0, then f is continuous at x0.",
      "theorem_type": "DEFINITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.RollesTheorem",
      "node_id": "src:lebl:sec4_2:rolles_theorem",
      "reasbook_alignment": "Lebl v6.2 Thm 4.2.2 <-> v6.3 Thm 4.2.2 (Identical)",
      "secondary_ref": "Trench \u00a72.3 Theorem 2.3.4",
      "section": "\u00a74.2",
      "source_ref": "Theorem 4.2.2 (Rolle's Theorem)",
      "statement_sha256": "447ab1f1dc9f283a9fb5e0f8cc64948df8fc7a75ac652d32c2db333b6bcce786",
      "statement_text": "If f: [a, b] -> R is continuous on [a, b], differentiable on (a, b), and f(a) = f(b), then there exists c in (a, b) such that f'(c) = 0.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.MeanValueTheorem",
      "node_id": "src:lebl:sec4_2:mean_value_theorem",
      "reasbook_alignment": "Lebl v6.2 Thm 4.2.4 <-> v6.3 Thm 4.2.4 (Identical)",
      "secondary_ref": "Trench \u00a72.3 Theorem 2.3.5",
      "section": "\u00a74.2",
      "source_ref": "Theorem 4.2.4 (Mean Value Theorem)",
      "statement_sha256": "cfc93e9348911ee21b89c29c22cad8dd790b34df73bde562c281fb657216b75e",
      "statement_text": "If f: [a, b] -> R is continuous on [a, b] and differentiable on (a, b), then there exists c in (a, b) such that f(b) - f(a) = f'(c)(b - a).",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.TaylorTheorem",
      "node_id": "src:lebl:sec4_3:taylor_theorem_with_remainder",
      "reasbook_alignment": "Lebl v6.2 Thm 4.3.1 <-> v6.3 Thm 4.3.1 (Identical)",
      "secondary_ref": "Trench \u00a72.5 Theorem 2.5.1",
      "section": "\u00a74.3",
      "source_ref": "Theorem 4.3.1 (Taylor's Theorem with Lagrange Remainder)",
      "statement_sha256": "77057cfd986d1dd83dcc19f5a038e72da754320e2b1b55b655b5c42d2020c443",
      "statement_text": "If f is n times continuously differentiable on [a, b] and (n+1)-differentiable on (a, b), then f(x) = sum_{k=0}^n (f^{(k)}(x0)/k!)(x - x0)^k + (f^{(n+1)}(xi)/(n+1)!)(x - x0)^{n+1} for some xi between x0 and x.",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.RiemannIntegrability",
      "node_id": "src:lebl:sec5_1:darboux_riemann_integrability",
      "reasbook_alignment": "Lebl v6.2 Thm 5.1.9 <-> v6.3 Thm 5.1.9 (Identical)",
      "secondary_ref": "Trench \u00a73.1 Definition 3.1.1, Theorem 3.1.2",
      "section": "\u00a75.1",
      "source_ref": "Definition 5.1.1, 5.1.7, Theorem 5.1.9 (Riemann / Darboux Integrability Criterion)",
      "statement_sha256": "ddb80e7aecfea8af84931b3d6b2ec585486d12cd773e19e3069aa3b1e18f938d",
      "statement_text": "A bounded function f: [a, b] -> R is Riemann integrable if and only if for every eps > 0 there exists a partition P of [a, b] such that U(f, P) - L(f, P) < eps.",
      "theorem_type": "DEFINITION_AND_THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.FundamentalTheoremCalculus",
      "node_id": "src:lebl:sec5_3:fundamental_theorem_of_calculus",
      "reasbook_alignment": "Lebl v6.2 Thm 5.3.1, 5.3.3 <-> v6.3 Thm 5.3.1, 5.3.3 (Identical)",
      "secondary_ref": "Trench \u00a73.3 Theorem 3.3.1, 3.3.2",
      "section": "\u00a75.3",
      "source_ref": "Theorem 5.3.1 (FTC Part 1), Theorem 5.3.3 (FTC Part 2)",
      "statement_sha256": "77f9cbc838e99deca594f84cd4a902d6d19a7aeac773ff867a1aa9230572e045",
      "statement_text": "(FTC 1) If f is continuous on [a, b] and F(x) = int_a^x f(t)dt, then F'(x) = f(x). (FTC 2) If f is Riemann integrable and F' = f, then int_a^b f(x)dx = F(b) - F(a).",
      "theorem_type": "THEOREM"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.UniformConvergenceDef",
      "node_id": "src:lebl:sec6_1:pointwise_vs_uniform_convergence",
      "reasbook_alignment": "Lebl v6.2 Def 6.1.4 <-> v6.3 Def 6.1.4 (Identical)",
      "secondary_ref": "Trench \u00a74.4 Definition 4.4.1, 4.4.2",
      "section": "\u00a76.1",
      "source_ref": "Definition 6.1.1 (Pointwise), Definition 6.1.4 (Uniform Convergence)",
      "statement_sha256": "04be30bcd38c281ca6538cf3928bcef6408ccd6aa906c6a6247c1b7aab49c125",
      "statement_text": "f_n -> f uniformly on A if for every eps > 0 there exists N in N such that for all n >= N and all x in A, |f_n(x) - f(x)| < eps. Pointwise convergence permits N to depend on x.",
      "theorem_type": "DEFINITION"
    },
    {
      "corpus_id": "LEBL_BASIC_ANALYSIS_1",
      "lean_formal_id": "MAPEOGEOFormal.WaveF4.UniformPreservationInterchange",
      "node_id": "src:lebl:sec6_2:preservation_interchange_uniform_convergence",
      "reasbook_alignment": "Lebl v6.2 Thm 6.2.1, 6.2.3 <-> v6.3 Thm 6.2.1, 6.2.3 (Identical)",
      "secondary_ref": "Trench \u00a74.4 Theorem 4.4.3, 4.4.4",
      "section": "\u00a76.2",
      "source_ref": "Theorem 6.2.1 (Uniform Limit of Continuous Functions is Continuous), Theorem 6.2.3 (Interchange of Limit and Integral)",
      "statement_sha256": "cb8e1f59487269284358eb26497cd50107764e1ddbe43b6705dcc918282996e8",
      "statement_text": "If f_n -> f uniformly on [a, b] and each f_n is continuous, then f is continuous and lim int_a^b f_n = int_a^b lim f_n = int_a^b f.",
      "theorem_type": "THEOREM"
    }
