+        bp,bm = (z+x)/np.sqrt(2), (z-x)/np.sqrt(2)
+        self.close(z@c@bp + z@c@bm + x@c@bp - x@c@bm, -2*np.sqrt(2))
+
+    def test_joint_maximally_mixed_and_random_roundtrip(self):
